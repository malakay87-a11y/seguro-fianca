body {
  font-family: Arial, sans-serif;
  line-height: 1.6;
  margin: 0;
  padding: 0;
  background: #f9f9f9;
  color: #333;
}

header {
  background: #004aad;
  color: #fff;
  padding: 20px;
  text-align: center;
}

h1, h2, h3 {
  margin-bottom: 10px;
}

#cotacao {
  background: #fff;
  padding: 20px;
  margin: 20px auto;
  max-width: 400px;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

form input, form button {
  display: block;
  width: 100%;
  margin: 10px 0;
  padding: 12px;
  font-size: 16px;
}

form button {
  background: #ff6600;
  color: #fff;
  border: none;
  cursor: pointer;
  font-weight: bold;
  border-radius: 5px;
}

form button:hover {
  background: #e65c00;
}

.cta-button {
  display: inline-block;
  background: #28a745;
  color: #fff;
  padding: 12px 20px;
  text-decoration: none;
  border-radius: 5px;
  font-weight: bold;
}

.cta-button:hover {
  background: #218838;
}

#depoimentos {
  background: #fff;
  padding: 20px;
  margin: 20px;
  border-radius: 8px;
  box-shadow: 0 2px 6px rgba(0,0,0,0.1);
}

blockquote {
  font-style: italic;
  margin: 10px 0;
  color: #555;
}
